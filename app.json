{
  "expo": {
    "name": "Bhumi Social AI",
    "slug": "SocialApp",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/bhumi-social-ai-logo.jpg",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bhumi.socialapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/bhumi-social-ai-logo.jpg"
      },
      "package": "com.bhumi_socialmediaai.SocialApp",
      "versionCode": 9,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/bhumi-social-ai-logo.jpg"
    },
    "plugins": [
      "expo-video",
      "expo-secure-store",
      "munim-ffmpeg",
      "expo-audio",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SocialApp to use the camera to record Reels.",
          "microphonePermission": "Allow SocialApp to use the microphone to record Reels with audio.",
          "recordAudioAndroid": true
        }
      ],
      "expo-font",
      "expo-status-bar",
      "@livekit/react-native-expo-plugin"
    ],
    "extra": {
      "eas": {
        "projectId": "8c9ddb30-5746-4914-bb36-37a4c109f052"
      }
    },
    "scheme": "bhumisocial",
    "androidStatusBar": {
      "backgroundColor": "#08050D",
      "barStyle": "dark-content",
      "hidden": false,
      "translucent": false
    },
    "updates": {
      "url": "https://u.expo.dev/8c9ddb30-5746-4914-bb36-37a4c109f052",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
